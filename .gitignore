# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — never commit these, they hold your database keys
.env
.env*.local
.env.local
.env.production
.env.import

# the one-off document import: the source spreadsheet and its generated
# reports can both carry vendor PII and must stay local
/scripts/import/input/*
!/scripts/import/input/.gitkeep
/scripts/import/output/

# vercel
.vercel

# typescript
*.tsbuildinfo

# playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache
/tests/.auth
