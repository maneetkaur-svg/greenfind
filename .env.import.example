# Copy this file to .env.import (repo root) and fill in the values.
# .env.import is read only by the one-off scripts in scripts/import/ — the
# Next.js app never reads it — and must never be committed. It is already
# in .gitignore.

# The Supabase project this import should run against. Almost always your
# STAGING project — see BRANCHING.md. Find it in Supabase → Project Settings
# → API → Project URL.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# The service_role key for that SAME project (Project Settings → API →
# service_role). This bypasses every row-level security rule. Keep it out of
# git, Slack and anywhere else it could leak.
SUPABASE_SERVICE_ROLE_KEY=

# Your PRODUCTION Supabase project's host — no "https://", no trailing
# slash, e.g. abcxyz123.supabase.co. When this is set, the script refuses to
# run if SUPABASE_URL above matches it, unless you pass --allow-prod. When
# this is left blank, the script refuses to run AT ALL unless you pass
# --allow-prod, because it has no way to tell staging from production.
PROD_SUPABASE_HOST=

# Needed only for scripts/import/verify-gst-bulk.ts (and the Next.js app
# itself, for the same feature when a new vendor is created — set this one
# in Vercel's own Environment Variables too, not just here). From your
# gstinapi.in dashboard: API Keys page (https://www.gstinapi.in/api-keys).
# Free tier: 100 credits total, 1 credit per successful lookup.
GSTINAPI_TOKEN=

# Override only if gstinapi.in's base URL changes from the documented
# default (https://www.gstinapi.in).
GSTINAPI_BASE_URL=
